{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handouter local material package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "lecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
        "course_title": {"type": "string", "minLength": 1, "maxLength": 200},
        "lecture_date": {"type": ["string", "null"], "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "audio": {"$ref": "#/$defs/audio"},
    "media": {"$ref": "#/$defs/media"},
    "transcript": {"$ref": "#/$defs/transcript"},
    "slides": {"$ref": "#/$defs/slides"}
  },
  "allOf": [
    {"anyOf": [{"required": ["audio"]}, {"required": ["media"]}, {"required": ["transcript"]}]},
    {"not": {"required": ["audio", "media"]}},
    {"not": {"required": ["media", "transcript"]}}
  ],
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"},
    "audio": {"type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {"path": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.(aac|flac|m4a|mp3|ogg|opus|wav)$"}]}}},
    "media": {"type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {"path": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.(aac|avi|flac|m2ts|m4a|m4v|mkv|mov|mp3|mp4|mpeg|mpg|mts|ogg|opus|ts|wav|webm)$"}]}}},
    "transcript": {"type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.txt$"}]},
        "origin": {"enum": ["provided_transcript", "asr_text"]},
        "segments_path": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.json$"}]},
        "raw_asr_path": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.json$"}]}
      }},
    "slides": {"type": "object", "additionalProperties": false, "required": ["images_dir"],
      "properties": {
        "images_dir": {"$ref": "#/$defs/path"},
        "metadata_path": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.json$"}]}
      }}
  }
}
